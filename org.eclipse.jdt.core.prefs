# Eclipse JDT 编译器偏好（由 .vscode/settings.json 的 java.settings.url 引用）
# 作用：把"未使用/预留"类代码检查全部设为 Ignore，避免接口、抽象类、预留方法报黄色警告
eclipse.preferences.version=1

# ===== 关闭全部 Javadoc 校验（一次性解决 Wrong tag / @return missing / @param missing 等所有 javadoc 警告） =====
org.eclipse.jdt.core.compiler.problem.invalidJavadoc=ignore
org.eclipse.jdt.core.compiler.problem.invalidJavadocTags=ignore
org.eclipse.jdt.core.compiler.problem.invalidJavadocTagsDeprecatedRef=ignore
org.eclipse.jdt.core.compiler.problem.invalidJavadocTagsNotVisibleRef=ignore
org.eclipse.jdt.core.compiler.problem.invalidJavadocTagsVisibility=public
org.eclipse.jdt.core.compiler.problem.malformedJavadocComments=ignore
org.eclipse.jdt.core.compiler.problem.missingJavadocTags=ignore
org.eclipse.jdt.core.compiler.problem.missingJavadocTagsMethodTypeParameters=ignore
org.eclipse.jdt.core.compiler.problem.missingJavadocTagsOverriding=ignore
org.eclipse.jdt.core.compiler.problem.missingJavadocTagsVisibility=public
org.eclipse.jdt.core.compiler.problem.missingJavadocComments=ignore
org.eclipse.jdt.core.compiler.problem.missingJavadocTagDescription=ignore
org.eclipse.jdt.core.compiler.problem.missingJavadocCommentsVisibility=public
org.eclipse.jdt.core.compiler.problem.javadocIncluded=ignore
org.eclipse.jdt.core.compiler.problem.duplicateTags=ignore
org.eclipse.jdt.core.compiler.problem.invalidJavadocTagsNotVisibleRef=ignore
org.eclipse.jdt.core.compiler.problem.nonExternalizedStringLiteral=ignore
org.eclipse.jdt.core.compiler.problem.unusedImports=ignore

# 未使用的私有成员/方法（return value never used 一类多源于此）
org.eclipse.jdt.core.compiler.problem.unusedPrivateMember=ignore
org.eclipse.jdt.core.compiler.problem.unusedWarningToken=ignore
org.eclipse.jdt.core.compiler.problem.duplicateTags=ignore
org.eclipse.jdt.core.compiler.problem.unusedObjectAllocation=ignore
org.eclipse.jdt.core.compiler.problem.unusedParameterWhenImplementingAbstract=ignore
org.eclipse.jdt.core.compiler.problem.unusedParameterWhenOverridingConcrete=ignore
org.eclipse.jdt.core.compiler.problem.unusedParameter=ignore
org.eclipse.jdt.core.compiler.problem.unusedTypeParameter=ignore
org.eclipse.jdt.core.compiler.problem.unusedLabel=ignore
org.eclipse.jdt.core.compiler.problem.unusedImport=ignore
org.eclipse.jdt.core.compiler.problem.redundantNullCheck=ignore
org.eclipse.jdt.core.compiler.problem.nullUncheckedConversion=ignore
org.eclipse.jdt.core.compiler.problem.potentialNullReference=ignore
org.eclipse.jdt.core.compiler.problem.nullReference=ignore
